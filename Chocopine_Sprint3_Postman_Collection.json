{
  "info": {
    "name": "Chocopine Sprint 3 – Full API Collection",
    "description": "Postman Collection đầy đủ cho toàn bộ API của hệ thống Choco Pine Bakery 3D.\nBao gồm: Auth, Cart, Orders, Admin Orders, Products, Reviews, Vouchers, Loyalty, Dashboard, Audit, Settings, Shifts, POS, Staff, Payment, Health Check.\n\nCách dùng:\n1. Import collection này vào Postman\n2. Tạo Environment với biến: baseUrl=http://localhost:8080\n3. Chạy request 'Login' trước để lấy accessToken\n4. Dán accessToken vào biến 'token' của Environment\n5. Các request cần auth đều dùng {{token}} tự động",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "chocopine-sprint3-full-v2"
  },
  "item": [
    {
      "name": "1. Authentication",
      "description": "Đăng ký, đăng nhập, refresh token, quên mật khẩu, Google OAuth2, 2FA TOTP",
      "item": [
        {
          "name": "Register (Đăng ký)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"hoTen\": \"Nguyễn Văn A\",\n    \"email\": \"nguyenvana@example.com\",\n    \"matKhau\": \"Password123!\",\n    \"soDienThoai\": \"0901234567\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "Login (Đăng nhập)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.accessToken) {",
                  "    pm.environment.set('token', json.accessToken);",
                  "    pm.environment.set('refreshToken', json.refreshToken);",
                  "    console.log('Token saved!');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin@chocopine.com\",\n    \"matKhau\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Login với 2FA TOTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin@chocopine.com\",\n    \"matKhau\": \"admin123\",\n    \"totpCode\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh?refreshToken={{refreshToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh"],
              "query": [{ "key": "refreshToken", "value": "{{refreshToken}}" }]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "logout"]
            }
          }
        },
        {
          "name": "Forgot Password (Quên mật khẩu)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"user@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "forgot-password"]
            }
          }
        },
        {
          "name": "Reset Password (Đặt lại mật khẩu)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"user@example.com\",\n    \"otp\": \"123456\",\n    \"newPassword\": \"NewPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "reset-password"]
            }
          }
        },
        {
          "name": "OTP SĐT – Gửi mã OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"soDienThoai\": \"0901234567\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/otp/send",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "otp", "send"]
            }
          }
        },
        {
          "name": "OTP SĐT – Xác thực OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"soDienThoai\": \"0901234567\",\n    \"otp\": \"123456\",\n    \"hoTen\": \"Nguyễn Văn B\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/otp/verify",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "otp", "verify"]
            }
          }
        },
        {
          "name": "Google OAuth2 Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"idToken\": \"GOOGLE_ID_TOKEN_FROM_FRONTEND\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/google",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "google"]
            }
          }
        },
        {
          "name": "2FA TOTP – Setup (Lấy QR Code)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/totp/setup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "totp", "setup"]
            }
          }
        },
        {
          "name": "2FA TOTP – Verify & Enable",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/totp/verify?code=123456",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "totp", "verify"],
              "query": [{ "key": "code", "value": "123456" }]
            }
          }
        },
        {
          "name": "2FA TOTP – Disable",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/totp/disable",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "totp", "disable"]
            }
          }
        }
      ]
    },
